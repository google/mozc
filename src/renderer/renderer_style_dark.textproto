# proto-file: protocol/renderer_style.proto
# proto-message: RendererStyle
window_border: 1
scrollbar_width: 4
row_rect_padding: 1
border_color { r: 74 g: 74 b: 74 }
shortcut_style {
  font_size: 14
  foreground_color { r: 144 g: 144 b: 144 }
  background_color { r: 50 g: 51 b: 58 }
  left_padding: 8
  right_padding: 8
}
gap1_style { font_size: 14 }
candidate_style {
  font_size: 14
  foreground_color { r: 229 g: 229 b: 229 }
  background_color { r: 44 g: 44 b: 44 }
}
description_style {
  font_size: 12
  foreground_color { r: 144 g: 144 b: 144 }
  right_padding: 8
}
# We want to ensure that the candidate window is at least wide
# enough to render "そのほかの文字種" as a candidate.
column_minimum_width_string: "そのほかの文字種"
footer_style {
  font_size: 14
  foreground_color { r: 144 g: 144 b: 144 }
  left_padding: 4
  right_padding: 4
}
footer_sub_label_style {
  font_size: 10
  foreground_color { r: 128 g: 128 b: 128 }
  left_padding: 4
  right_padding: 4
}
footer_border_colors { r: 74 g: 74 b: 74 }
footer_top_color { r: 33 g: 33 b: 33 }
footer_bottom_color { r: 33 g: 33 b: 33 }
logo_file_name: "candidate_window_logo.tiff"
focused_background_color { r: 61 g: 61 b: 61 }
focused_border_color { r: 85 g: 85 b: 85 }
scrollbar_background_color { r: 53 g: 53 b: 53 }
scrollbar_indicator_color { r: 110 g: 110 b: 110 }
infolist_style {
  caption_string: "用例"
  caption_height: 20
  caption_padding: 1
  caption_style {
    font_size: 12
    left_padding: 2
    foreground_color { r: 229 g: 229 b: 229 }
  }
  caption_background_color { r: 33 g: 33 b: 33 }
  window_border: 1
  row_rect_padding: 2
  window_width: 300
  title_style {
    font_size: 15
    left_padding: 5
    foreground_color { r: 229 g: 229 b: 229 }
  }
  description_style {
    font_size: 12
    left_padding: 15
    foreground_color { r: 176 g: 176 b: 176 }
  }
  border_color { r: 74 g: 74 b: 74 }
  focused_background_color { r: 61 g: 61 b: 61 }
  focused_border_color { r: 85 g: 85 b: 85 }
}
