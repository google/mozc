load(
    "//:build_defs.bzl",
    "mozc_cc_library",
    "mozc_cc_test",
)

package(default_visibility = ["//visibility:private"])

mozc_cc_library(
    name = "user_dictionary_storage",
    srcs = ["user_dictionary_storage.cc"],
    hdrs = ["user_dictionary_storage.h"],
    visibility = [
        "//:__subpackages__",
        "//gui:__subpackages__",
        "//rewriter:__pkg__",
    ],
    deps = [
        "//base:file_stream",
        "//base:file_util",
        "//base:process_mutex",
        "//base/protobuf:coded_stream",
        "//base/protobuf:zero_copy_stream_impl",
        "//dictionary:user_dictionary_util",
        "//dictionary:user_pos",
        "//protocol:user_dictionary_storage_cc_proto",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/random",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
    ],
)

mozc_cc_test(
    name = "user_dictionary_storage_test",
    size = "small",
    srcs = ["user_dictionary_storage_test.cc"],
    deps = [
        ":user_dictionary_importer",
        ":user_dictionary_storage",
        "//base:file_stream",
        "//base:file_util",
        "//base:mmap",
        "//base:random",
        "//base:system_util",
        "//base/file:temp_dir",
        "//dictionary:user_dictionary_util",
        "//protocol:user_dictionary_storage_cc_proto",
        "//testing:gunit_main",
        "//testing:mozctest",
        "//testing:testing_util",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/random",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_library(
    name = "user_dictionary_importer",
    srcs = ["user_dictionary_importer.cc"],
    hdrs = ["user_dictionary_importer.h"],
    textual_hdrs = ["//dictionary:pos_map"],
    visibility = [
        "//:__subpackages__",
        "//gui:__subpackages__",
    ],
    deps = [
        ":user_dictionary_storage",
        "//base:hash",
        "//base:japanese_util",
        "//base:mmap",
        "//base:number_util",
        "//base:util",
        "//base:vlog",
        "//base/strings:assign",
        "//base/strings:unicode",
        "//dictionary:user_dictionary_util",
        "//protocol:user_dictionary_storage_cc_proto",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/hash",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_test(
    name = "user_dictionary_importer_test",
    size = "small",
    srcs = ["user_dictionary_importer_test.cc"],
    deps = [
        ":user_dictionary_importer",
        ":user_dictionary_storage",
        "//dictionary:user_dictionary_util",
        "//protocol:user_dictionary_storage_cc_proto",
        "//testing:gunit_main",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
    ],
)
